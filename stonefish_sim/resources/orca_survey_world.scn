    <animated name="FishB3" type="model" collisions="true">
        <physical>
            <mesh filename="data/fish.obj" scale="1.50"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Fish"/>
        <look name="fish_amber"/>
        <trajectory type="spline" playback="repeat">
            <keypoint time="0.00" xyz="-17.07 5.13 13.80" rpy="0.0 0.0 2.911"/>
            <keypoint time="2.76" xyz="-30.10 8.20 13.27" rpy="0.0 0.0 -2.587"/>
            <keypoint time="5.52" xyz="-41.50 1.14 12.05" rpy="0.0 0.0 -1.802"/>
            <keypoint time="8.24" xyz="-44.56 -11.89 10.86" rpy="0.0 0.0 -1.016"/>
            <keypoint time="11.00" xyz="-37.51 -23.29 10.40" rpy="0.0 0.0 -0.231"/>
            <keypoint time="13.76" xyz="-24.47 -26.35 10.93" rpy="0.0 0.0 0.554"/>
            <keypoint time="16.48" xyz="-13.08 -19.30 12.15" rpy="0.0 0.0 1.340"/>
            <keypoint time="19.24" xyz="-10.01 -6.26 13.34" rpy="0.0 0.0 2.125"/>
            <keypoint time="22.00" xyz="-17.07 5.13 13.80" rpy="0.0 0.0 2.125"/>
        </trajectory>
    </animated>

    <animated name="FishC1" type="model" collisions="true">
        <physical>
            <mesh filename="data/fish.obj" scale="2.60"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Fish"/>
        <look name="fish_silver"/>
        <trajectory type="spline" playback="repeat">
            <keypoint time="0.00" xyz="-0.85 -33.12 12.10" rpy="0.0 0.0 -0.231"/>
            <keypoint time="1.52" xyz="6.97 -34.95 13.30" rpy="0.0 0.0 0.552"/>
            <keypoint time="3.00" xyz="13.81 -30.74 13.80" rpy="0.0 0.0 1.340"/>
            <keypoint time="4.48" xyz="15.65 -22.91 13.30" rpy="0.0 0.0 2.123"/>
            <keypoint time="6.00" xyz="11.43 -16.07 12.10" rpy="0.0 0.0 2.911"/>
            <keypoint time="7.52" xyz="3.61 -14.23 10.90" rpy="0.0 0.0 -2.589"/>
            <keypoint time="9.00" xyz="-3.23 -18.45 10.40" rpy="0.0 0.0 -1.802"/>
            <keypoint time="10.48" xyz="-5.07 -26.27 10.90" rpy="0.0 0.0 -1.018"/>
            <keypoint time="12.00" xyz="-0.85 -33.12 12.10" rpy="0.0 0.0 -1.018"/>
        </trajectory>
    </animated>

    <animated name="FishC2" type="model" collisions="true">
