<?xml version="1.0"?>
<!--
    orca_survey_world.scn
    Scenario 1: Orca XLUUV surveying the ocean floor while reactively
    avoiding obstacles that mimic a real seabed - scattered rocks (static
    bodies) and small fish schools (animated bodies looping through the
    area). The vehicle carries a forward "profiler" range sensor for
    obstacle avoidance and a downward "multibeam" sonar for the seabed
    survey itself (see resources/data/orca_xluuv_survey.scn).

    Run with the orca_survey_sim executable (src/main_survey.cpp), which
    drives src/OrcaController.cpp: a simple lawnmower/boustrophedon survey
    pattern with reactive turn-away-from-obstacle behaviour layered on top.

    Same single-<materials>-block / repeatable-<looks>-block rules as
    orca_world.scn apply here (see its header comment).
-->
<scenario>

    <environment>
        <ned latitude="36.6" longitude="-121.9"/>

        <ocean>
            <water density="1025.0" jerlov="0.12"/>
            <waves height="0.0"/>
            <current type="uniform">
                <velocity xyz="0.0 0.0 0.0"/>
            </current>
        </ocean>

        <atmosphere>
            <sun azimuth="20.0" elevation="55.0"/>
        </atmosphere>
    </environment>

    <!-- Fill light over the survey box so a wide camera still sees
         the hull, stones, and fish together. z=4 is 8 m above the boat. -->
    <light name="SurveyFill">
        <specs illuminance="90000.0" radius="140.0"/>
        <color rgb="0.72 0.86 1.0"/>
        <world_transform xyz="0.0 0.0 4.0" rpy="0.0 0.0 0.0"/>
    </light>

    <materials>
        <material name="Rock" density="2700.0" restitution="0.6"/>
        <material name="Sand" density="1800.0" restitution="0.3"/>
        <material name="HullShell" density="4100.0" restitution="0.3"/>
        <material name="Composite" density="1800.0" restitution="0.4"/>
        <material name="SyntacticFoam" density="500.0" restitution="0.3"/>
        <material name="Fish" density="1025.0" restitution="0.2"/>

        <friction_table>
            <friction material1="Rock" material2="Rock" static="0.7" dynamic="0.5"/>
            <friction material1="Sand" material2="Sand" static="0.5" dynamic="0.3"/>
            <friction material1="Rock" material2="Sand" static="0.6" dynamic="0.4"/>
        </friction_table>
    </materials>

    <looks>
        <look name="seabed_look" rgb="0.62 0.58 0.36" roughness="0.92" metalness="0.0"/>
        <look name="rock_sand" rgb="0.78 0.62 0.38" roughness="0.85" metalness="0.02"/>
        <look name="rock_olive" rgb="0.42 0.58 0.36" roughness="0.8" metalness="0.02"/>
        <look name="rock_slate" rgb="0.55 0.62 0.68" roughness="0.7" metalness="0.05"/>
        <look name="fish_silver" rgb="0.92 0.94 0.78" roughness="0.35" metalness="0.05"/>
        <look name="fish_dark" rgb="0.15 0.72 0.62" roughness="0.4" metalness="0.04"/>
        <look name="fish_amber" rgb="0.95 0.62 0.18" roughness="0.4" metalness="0.04"/>
    </looks>

    <!-- Flat seabed, 500 m below the surface, matching orca_world.scn -->
    <static name="Seabed" type="plane">
        <material name="Sand"/>
        <look name="seabed_look"/>
        <world_transform xyz="0.0 0.0 18.00" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Irregular stones sitting on the sand. The mesh base is local z=0,
         placed on the seabed plane at z=500. Convex hull is the collision shape
         the profiler and multibeam actually hit. -->
    <static name="Rock01" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="1.15" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="16.73 -38.00 17.85" rpy="0.12 -0.08 0.40"/>
    </static>

    <static name="Rock02" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="1.45" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-32.08 8.16 17.85" rpy="0.12 -0.08 1.20"/>
    </static>

    <static name="Rock03" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="0.85" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-59.22 24.47 17.85" rpy="0.12 -0.08 2.40"/>
    </static>

    <static name="Rock04" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="0.70" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-16.92 -12.48 17.85" rpy="0.12 -0.08 0.80"/>
    </static>

    <static name="Rock05" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="1.55" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="15.44 30.84 17.85" rpy="0.12 -0.08 3.10"/>
    </static>

    <static name="Rock06" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="1.30" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="43.98 -9.59 17.85" rpy="0.12 -0.08 1.70"/>
    </static>

    <static name="Rock07" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="1.60" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-51.43 10.80 17.85" rpy="0.12 -0.08 0.30"/>
    </static>

    <static name="Rock08" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="0.90" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-32.51 -37.43 17.85" rpy="0.12 -0.08 2.20"/>
    </static>

    <static name="Rock09" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="1.25" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="46.16 11.43 17.85" rpy="0.12 -0.08 4.00"/>
    </static>

    <static name="Rock10" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="1.05" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-33.68 39.80 17.85" rpy="0.12 -0.08 1.10"/>
    </static>

    <static name="Rock11" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="1.35" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-14.21 39.69 17.85" rpy="0.12 -0.08 5.20"/>
    </static>

    <static name="Rock12" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="1.10" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="16.92 -31.08 17.85" rpy="0.12 -0.08 2.80"/>
    </static>

    <static name="Rock13" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="1.40" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="0.92 -31.49 17.85" rpy="0.12 -0.08 0.60"/>
    </static>

    <static name="Rock14" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="0.80" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
