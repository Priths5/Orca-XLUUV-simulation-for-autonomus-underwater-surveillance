            <keypoint time="0.00" xyz="-15.27 3.53 12.10" rpy="0.0 0.0 2.911"/>
            <keypoint time="2.76" xyz="-28.30 6.60 13.30" rpy="0.0 0.0 -2.587"/>
            <keypoint time="5.52" xyz="-39.70 -0.46 13.80" rpy="0.0 0.0 -1.802"/>
            <keypoint time="8.24" xyz="-42.76 -13.49 13.30" rpy="0.0 0.0 -1.016"/>
            <keypoint time="11.00" xyz="-35.71 -24.89 12.10" rpy="0.0 0.0 -0.231"/>
            <keypoint time="13.76" xyz="-22.67 -27.95 10.90" rpy="0.0 0.0 0.554"/>
            <keypoint time="16.48" xyz="-11.28 -20.90 10.40" rpy="0.0 0.0 1.340"/>
            <keypoint time="19.24" xyz="-8.21 -7.86 10.90" rpy="0.0 0.0 2.125"/>
            <keypoint time="22.00" xyz="-15.27 3.53 12.10" rpy="0.0 0.0 2.125"/>
        </trajectory>
    </animated>

    <animated name="FishB2" type="model" collisions="true">
        <physical>
            <mesh filename="data/fish.obj" scale="1.90"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Fish"/>
        <look name="fish_dark"/>
        <trajectory type="spline" playback="repeat">
            <keypoint time="0.00" xyz="-13.07 4.53 13.32" rpy="0.0 0.0 2.911"/>
            <keypoint time="2.76" xyz="-26.10 7.60 13.80" rpy="0.0 0.0 -2.587"/>
            <keypoint time="5.52" xyz="-37.50 0.54 13.28" rpy="0.0 0.0 -1.802"/>
