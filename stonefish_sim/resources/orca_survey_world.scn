        <world_transform xyz="33.44 2.43 17.85" rpy="0.12 -0.08 3.60"/>
    </static>

    <static name="Rock15" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="1.20" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="8.08 -33.70 17.85" rpy="0.12 -0.08 1.90"/>
    </static>

    <static name="Rock16" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="1.50" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-28.19 29.79 17.85" rpy="0.12 -0.08 4.40"/>
    </static>

    <static name="Rock17" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="1.00" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-15.19 31.97 17.85" rpy="0.12 -0.08 0.20"/>
    </static>

    <static name="Rock18" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="0.95" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-52.94 -34.61 17.85" rpy="0.12 -0.08 2.60"/>
    </static>


    <!-- Extra obstacles that reach the cruise depth, not only the sand. -->
    <static name="Pillar01" type="cylinder">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <dimensions radius="0.85" height="6.5"/>
        <world_transform xyz="6.0 -6.0 14.75" rpy="0.0 0.0 0.4"/>
    </static>
    <static name="Pillar02" type="cylinder">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <dimensions radius="0.65" height="5.5"/>
        <world_transform xyz="30.0 14.0 15.25" rpy="0.08 0.0 1.2"/>
    </static>
    <static name="Pillar03" type="cylinder">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <dimensions radius="1.05" height="7.0"/>
        <world_transform xyz="-16.0 18.0 14.50" rpy="0.0 0.05 2.1"/>
    </static>
    <static name="Wreck01" type="box">
        <material name="Composite"/>
        <look name="rock_slate"/>
        <dimensions xyz="9.0 1.6 2.2"/>
        <world_transform xyz="14.0 -20.0 15.6" rpy="0.15 0.2 0.7"/>
    </static>
    <static name="Wreck02" type="box">
        <material name="Composite"/>
        <look name="rock_olive"/>
        <dimensions xyz="6.5 2.4 1.8"/>
        <world_transform xyz="-6.0 6.0 16.0" rpy="0.1 -0.25 1.8"/>
    </static>
    <static name="Boulder01" type="model">
        <material name="Rock"/>
        <look name="rock_sand"/>
        <physical>
            <mesh filename="data/rock_c.obj" scale="3.2" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="22.0 -26.0 17.85" rpy="0.1 0.05 0.8"/>
    </static>
    <static name="Boulder02" type="model">
        <material name="Rock"/>
        <look name="rock_olive"/>
        <physical>
            <mesh filename="data/rock_a.obj" scale="2.8" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="-24.0 -2.0 17.85" rpy="0.05 -0.1 2.4"/>
    </static>
    <static name="Boulder03" type="model">
        <material name="Rock"/>
        <look name="rock_slate"/>
        <physical>
            <mesh filename="data/rock_b.obj" scale="3.6" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <world_transform xyz="4.0 30.0 17.85" rpy="0.12 0.0 1.1"/>
    </static>

    <!-- Schools swim wider, faster loops and also rise and dive.
         FishBig* are the large ones crossing the survey lanes. -->
    <animated name="FishA1" type="model" collisions="true">
        <physical>
            <mesh filename="data/fish.obj" scale="2.60"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Fish"/>
        <look name="fish_silver"/>
        <trajectory type="spline" playback="repeat">
            <keypoint time="0.00" xyz="14.05 26.93 12.10" rpy="0.0 0.0 -2.287"/>
            <keypoint time="2.00" xyz="7.01 18.85 13.30" rpy="0.0 0.0 -1.501"/>
            <keypoint time="4.00" xyz="7.77 8.16 13.80" rpy="0.0 0.0 -0.716"/>
            <keypoint time="6.00" xyz="15.85 1.12 13.30" rpy="0.0 0.0 0.070"/>
            <keypoint time="8.00" xyz="26.54 1.87 12.10" rpy="0.0 0.0 0.855"/>
            <keypoint time="10.00" xyz="33.58 9.96 10.90" rpy="0.0 0.0 1.641"/>
            <keypoint time="12.00" xyz="32.83 20.65 10.40" rpy="0.0 0.0 2.426"/>
            <keypoint time="14.00" xyz="24.74 27.69 10.90" rpy="0.0 0.0 -3.071"/>
            <keypoint time="16.00" xyz="14.05 26.93 12.10" rpy="0.0 0.0 -3.071"/>
        </trajectory>
    </animated>

    <animated name="FishA2" type="model" collisions="true">
        <physical>
            <mesh filename="data/fish.obj" scale="1.90"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Fish"/>
        <look name="fish_dark"/>
        <trajectory type="spline" playback="repeat">
            <keypoint time="0.00" xyz="16.25 27.93 13.32" rpy="0.0 0.0 -2.287"/>
            <keypoint time="2.00" xyz="9.21 19.85 13.80" rpy="0.0 0.0 -1.501"/>
            <keypoint time="4.00" xyz="9.97 9.16 13.28" rpy="0.0 0.0 -0.716"/>
            <keypoint time="6.00" xyz="18.05 2.12 12.08" rpy="0.0 0.0 0.070"/>
            <keypoint time="8.00" xyz="28.74 2.87 10.88" rpy="0.0 0.0 0.855"/>
            <keypoint time="10.00" xyz="35.78 10.96 10.40" rpy="0.0 0.0 1.641"/>
            <keypoint time="12.00" xyz="35.03 21.65 10.92" rpy="0.0 0.0 2.426"/>
            <keypoint time="14.00" xyz="26.94 28.69 12.12" rpy="0.0 0.0 -3.071"/>
            <keypoint time="16.00" xyz="16.25 27.93 13.32" rpy="0.0 0.0 -3.071"/>
        </trajectory>
    </animated>

    <animated name="FishA3" type="model" collisions="true">
