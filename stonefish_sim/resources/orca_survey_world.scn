            <mesh filename="data/fish.obj" scale="1.50"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <material name="Fish"/>
        <look name="fish_amber"/>
        <trajectory type="spline" playback="repeat">
            <keypoint time="0.00" xyz="12.25 28.53 13.80" rpy="0.0 0.0 -2.287"/>
            <keypoint time="2.00" xyz="5.21 20.45 13.27" rpy="0.0 0.0 -1.501"/>
            <keypoint time="4.00" xyz="5.97 9.76 12.05" rpy="0.0 0.0 -0.716"/>
