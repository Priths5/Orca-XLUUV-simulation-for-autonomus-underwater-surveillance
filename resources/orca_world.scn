<?xml version="1.0"?>
<!--
    orca_world.scn
    Top-level Stonefish scenario: open-ocean environment + seabed + Orca XLUUV.

    NOTE ON SCOPE: This models the Orca XLUUV *platform* (hull, mass, size,
    ballast/buoyancy, propulsion, sensors, modular payload bay as an empty
    cargo volume). It intentionally does NOT model the 'Moor-pedo' mine /
    weapon payloads shown in the reference image - the payload bay is left
    generic so you can attach your own (non-weapon) payload models, sensors,
    or cargo mass to it if needed.

    IMPORTANT: all materials used anywhere in the scenario - including
    "HullShell" and "Composite" used by the included orca_xluuv.scn robot -
    must be defined in THIS single <materials> block. ScenarioParser::Parse
    only reads the first <materials> element in the fully-merged document
    (root->FirstChildElement("materials"), no loop), so a second
    <materials> block anywhere else is silently ignored, not merged.
    <looks> is the opposite - ScenarioParser::ParseLooks IS called in a
    loop over every sibling <looks> element, so those can be split across
    files (orca_xluuv.scn keeps its own <looks> block).
-->
<scenario>

    <!-- ============================= ENVIRONMENT ============================= -->
    <environment>
        <ned latitude="36.6" longitude="-121.9"/> <!-- arbitrary open-ocean reference point -->

        <ocean>
            <water density="1025.0" jerlov="0.25"/>  <!-- match the tested Stonefish example configuration -->
            <waves height="0.0"/>  <!-- disable wave generation to avoid OpenGL/GPU crash on unsupported setups -->
            <current type="uniform">
                <velocity xyz="0.0 0.0 0.0"/> <!-- flat current, stable default -->
            </current>
        </ocean>

        <atmosphere>
            <sun azimuth="20.0" elevation="50.0"/>
        </atmosphere>
    </environment>

    <!-- ============================== MATERIALS =============================== -->
    <!-- All materials for the whole scenario live here (see note above). -->
    <materials>
        <material name="Rock" density="2700.0" restitution="0.6"/>
        <material name="Sand" density="1800.0" restitution="0.3"/>

        <!-- Effective density tuned so the hollow shell + internal
             equipment mass nets out to roughly the 80-85 t spec (a
             fully-solid steel cylinder this size would weigh far more). -->
        <material name="HullShell" density="7900.0" restitution="0.3"/>
        <material name="Composite" density="1800.0" restitution="0.4"/>

        <friction_table>
            <friction material1="Rock" material2="Rock" static="0.7" dynamic="0.5"/>
            <friction material1="Sand" material2="Sand" static="0.5" dynamic="0.3"/>
            <friction material1="Rock" material2="Sand" static="0.6" dynamic="0.4"/>
        </friction_table>
    </materials>

    <looks>
        <look name="seabed_look" gray="0.5" roughness="0.9"/>
    </looks>

    <!-- Flat seabed, 500 m below the surface (deep-ocean XLUUV mission depth) -->
    <static name="Seabed" type="plane">
        <material name="Sand"/>
        <look name="seabed_look"/>
        <world_transform xyz="0.0 0.0 500.0" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- ============================ ORCA XLUUV ROBOT =========================== -->
    <include file="data/orca_xluuv.scn">
        <arg name="name" value="OrcaXLUUV"/>
        <arg name="start_x" value="0.0"/>
        <arg name="start_y" value="0.0"/>
        <arg name="start_z" value="10.0"/>  <!-- start 10 m below surface -->
    </include>

</scenario>
