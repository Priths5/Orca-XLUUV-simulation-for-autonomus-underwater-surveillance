<?xml version="1.0"?>
<package format="3">
  <name>orca_rl_bridge</name>
  <version>0.2.0</version>
  <description>Runs the trained Orca RL navigation policy against the Stonefish Orca XLUUV (stonefish_sim/orca_rl_sim) over ROS 2.</description>
  <maintainer email="you@example.com">your_name</maintainer>
  <license>MIT</license>

  <!-- Run directly with python3 (see README); this manifest records the runtime
       dependencies. Only standard ROS 2 interfaces are used - no Gazebo,
       gazebo_msgs, gazebo_ros, uuv_simulator or stonefish_ros2. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
